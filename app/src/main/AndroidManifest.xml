<?xml version="1.0" encoding="utf-8"?>

<!-- Configuración principal de la aplicación Android. -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="in.myinnos.swiggyanimation">

    <!-- Configuración general de la aplicación. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Actividad principal que inicia la aplicación. -->
        <activity android:name="in.myinnos.swiggyanimation.MainActivity">

            <!-- Define MainActivity como pantalla de inicio. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
    </application>

</manifest>
